# AWS USER KEYS
AWS_ACCESS_KEY_ID = "your access key"
AWS_SECRET_ACCESS_KEY = "your secret key"
AWS_REGION = "your region"

# AWS S3 BUCKET
S3_BUCKET= "your bucket name"

# From AWS-Bedrock get the following
BEDROCK_EMBED_MODEL= amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL= amazon.nova-lite-v1:0
EMBED_DIMENSION =1024



# Pinecorn

PINECORN_API_KEY = "your api key"
PINECORN_INDEX_NAME = "columbus-ai-index"
PINECORN_CLOUD = aws
PINECORN_REGION= us-east-1
PINECORN_READY_TIMEOUT = 180

# Render Postgres Credentials

DATABSE_URL= "your connection string"

# Rius configuration = this is for observibility

RIUS_API_KEY = "your api key"
RIUS_SERVICE_NAME= columbus_ai
RIUS_DISABLED = false
RIUS_CAPTURE_CONTENT= false
